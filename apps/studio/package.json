{
  "name": "agentic-odi-studio",
  "private": true,
  "version": "0.12.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:visual": "vitest run --config vitest.visual.config.ts",
    "chromatic": "chromatic --vitest",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "gen:api-types": "openapi-typescript openapi.json -o src/api/schema.d.ts",
    "dev:full": "concurrently -k -n mcp,sidecar,vite \"uv run python -m agentic_odi_mcp_server\" \"uv run python -m agentic_odi_studio_api.main\" \"vite\"",
    "tauri": "tauri"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.31",
    "@assistant-ui/react-markdown": "^0.14.24",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "idb": "^8.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@chromatic-com/vitest": "^1.0.1",
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^4.1.12",
    "chromatic": "^18.13.3",
    "concurrently": "^9.2.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.12",
    "vitest-browser-react": "^2.3.0"
  },
  "overrides": {
    "storybook": "10.6.3"
  }
}
