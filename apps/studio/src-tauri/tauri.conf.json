{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agentic ODI Living Studio",
  "version": "0.12.0",
  "identifier": "com.agenticodi.livingstudio",
  "build": {
    "beforeDevCommand": "npm run dev:full",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Agentic ODI Living Studio",
        "width": 1440,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "nsis",
      "dmg",
      "app"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/alehar9320/agentic-odi/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI4RDFFN0YwQ0ZDMENBNjQKUldSa3lzRFA4T2ZSdUhwMXM0K2gyM1ZGc2EvaHJqNDhkTkNYM1BkdU9XMXhWVk5RZXdqalZaTDcK"
    }
  }
}
